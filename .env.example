# ── REQUIRED ─────────────────────────────────────────────────────────────────
# GitHub Personal Access Token (needs 'repo' + 'workflow' scopes)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key (optional — set to enable natural language mode) GROQ API
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OPTIONAL OVERRIDES ────────────────────────────────────────────────────────
# GitHub organization or personal account name
GITHUB_OWNER=Chetan-Mohod

# Workflow file name inside .github/workflows/
WORKFLOW_FILE=AKS-CD.yml

# OpenAI model to use
OPENAI_MODEL=llama-3.1-8b-instant 

# App environment
APP_ENV=development
LOG_LEVEL=INFO

# PROD safety — change the token value to something only your team knows
PROD_CONFIRMATION_TOKEN=CONFIRM-PROD
